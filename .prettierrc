{
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 82,
  "tabWidth": 2,
  "arrowParens": "always",
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": [
    "^react$",
    "<THIRD_PARTY_MODULES>",
    "^@components/(.*)$",
    "^@assets/(.*)$",
    "^@hooks/(.*)$",
    "^@services/(.*)$",
    "^@store/(.*)$",
    "^@dto/(.*)$",
    "^@pages/(.*)$",
    "^@utils/(.*)$",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
